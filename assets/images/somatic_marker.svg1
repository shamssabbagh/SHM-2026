<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1100 560" width="100%" height="100%">
  <defs>
    <linearGradient id="bgSomatic" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FCF9F5"/>
      <stop offset="100%" stop-color="#F7F3ED"/>
    </linearGradient>

    <!-- חץ זרימה משלב לשלב (מימין לשמאל ב-RTL) -->
    <marker id="arrowRTL" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M 10 1 L 2 5 L 10 9 z" fill="#502638"/>
    </marker>

    <filter id="stepShadow" x="-4%" y="-4%" width="108%" height="110%">
      <feDropShadow dx="0" dy="8" stdDeviation="10" flood-color="#502638" flood-opacity="0.08"/>
    </filter>
  </defs>

  <rect width="1100" height="560" rx="22" fill="url(#bgSomatic)" stroke="#DEC7D0" stroke-width="2"/>

  <!-- כותרת -->
  <text x="550" y="44" text-anchor="middle" fill="#502638" font-family="sans-serif" font-size="22" font-weight="800">
    תיאוריית הסמנים הסומטיים (Somatic Marker Hypothesis — Antonio Damasio, 1994)
  </text>
  <text x="550" y="70" text-anchor="middle" fill="#5A5258" font-family="sans-serif" font-size="14" font-weight="600">
    כיצד זיכרונות רגשיים וגופניים מקצרים ומכוונים תהליכי קבלת החלטות בתנאי אי-ודאות (זרימה מימין לשמאל)
  </text>

  <!-- קווי חיבור בין 4 השלבים (מימין לשמאל) -->
  <g stroke="#502638" stroke-width="3" fill="none">
    <line x1="825" y1="265" x2="792" y2="265"/>
    <line x1="560" y1="265" x2="527" y2="265"/>
    <line x1="295" y1="265" x2="262" y2="265"/>
  </g>
  <!-- ראשי חצים לשמאל -->
  <polygon points="790,265 802,258 802,272" fill="#502638"/>
  <polygon points="525,265 537,258 537,272" fill="#D85B49"/>
  <polygon points="260,265 272,258 272,272" fill="#2E6B56"/>

  <!-- ==================== שלב 1 (ימין קיצוני): גירוי צרכני ==================== -->
  <g transform="translate(825, 115)" filter="url(#stepShadow)">
    <rect width="230" height="305" rx="18" fill="#FCF9F5" stroke="#502638" stroke-width="2.2"/>
    <circle cx="115" cy="48" r="26" fill="#EBD9DF" stroke="#502638" stroke-width="2"/>
    <text x="115" y="55" text-anchor="middle" fill="#502638" font-family="sans-serif" font-size="20" font-weight="800">1</text>

    <text x="115" y="102" text-anchor="middle" fill="#502638" font-family="sans-serif" font-size="18" font-weight="800">גירוי שיווקי / מותג</text>
    <text x="115" y="124" text-anchor="middle" fill="#6B2D46" font-family="sans-serif" font-size="13" font-weight="700">External Stimulus</text>

    <line x1="25" y1="140" x2="205" y2="140" stroke="#EBD9DF" stroke-width="1.5"/>

    <g fill="#252329" font-family="sans-serif" font-size="13.5" text-anchor="middle">
      <text x="115" y="172">חשיפה ללוגו מותג מוכר,</text>
      <text x="115" y="194">אריזת מוצר, ניחוח בחנות</text>
      <text x="115" y="216">או תג מחיר בדילמת קנייה.</text>
    </g>

    <rect x="20" y="245" width="190" height="42" rx="10" fill="#F6EEF1" stroke="#C9AEBA"/>
    <text x="115" y="271" text-anchor="middle" fill="#502638" font-family="sans-serif" font-size="12.5" font-weight="700">הפעלת זיכרון חווייתי קודם</text>
  </g>

  <!-- ==================== שלב 2: עוררות אמיגדלה וגוף ==================== -->
  <g transform="translate(560, 115)" filter="url(#stepShadow)">
    <rect width="230" height="305" rx="18" fill="#FCF9F5" stroke="#D85B49" stroke-width="2.2"/>
    <circle cx="115" cy="48" r="26" fill="#FADCD6" stroke="#D85B49" stroke-width="2"/>
    <text x="115" y="55" text-anchor="middle" fill="#B83D2B" font-family="sans-serif" font-size="20" font-weight="800">2</text>

    <text x="115" y="102" text-anchor="middle" fill="#502638" font-family="sans-serif" font-size="18" font-weight="800">הפעלה רגשית ראשונית</text>
    <text x="115" y="124" text-anchor="middle" fill="#B83D2B" font-family="sans-serif" font-size="13" font-weight="700">Amygdala &amp; Insula</text>

    <line x1="25" y1="140" x2="205" y2="140" stroke="#FADCD6" stroke-width="1.5"/>

    <g fill="#252329" font-family="sans-serif" font-size="13.5" text-anchor="middle">
      <text x="115" y="172">האמיגדלה והאינסולה</text>
      <text x="115" y="194">מעוררות תגובה אוטונומית</text>
      <text x="115" y="216">או סימולציה מוחית פנימית.</text>
    </g>

    <!-- גל דופק גופני -->
    <rect x="20" y="245" width="190" height="42" rx="10" fill="#FADCD6" stroke="#D85B49"/>
    <path d="M 40 266 L 75 266 L 85 252 L 95 280 L 107 250 L 118 276 L 128 266 L 190 266" fill="none" stroke="#B83D2B" stroke-width="2.2"/>
  </g>

  <!-- ==================== שלב 3: הסמן הסומטי ("תחושת בטן") ==================== -->
  <g transform="translate(295, 115)" filter="url(#stepShadow)">
    <rect width="230" height="305" rx="18" fill="#FCF9F5" stroke="#9E3B66" stroke-width="2.2"/>
    <circle cx="115" cy="48" r="26" fill="#F2DCE6" stroke="#9E3B66" stroke-width="2"/>
    <text x="115" y="55" text-anchor="middle" fill="#7A244B" font-family="sans-serif" font-size="20" font-weight="800">3</text>

    <text x="115" y="102" text-anchor="middle" fill="#502638" font-family="sans-serif" font-size="18" font-weight="800">הסמן הסומטי (vmPFC)</text>
    <text x="115" y="124" text-anchor="middle" fill="#7A244B" font-family="sans-serif" font-size="13" font-weight="700">Somatic Marker Signal</text>

    <line x1="25" y1="140" x2="205" y2="140" stroke="#EBD9DF" stroke-width="1.5"/>

    <g fill="#252329" font-family="sans-serif" font-size="13.5" text-anchor="middle">
      <text x="115" y="172">קליפת המוח הקדם-מצחית</text>
      <text x="115" y="194">הגחלית-תיכונה משלבת את האות</text>
      <text x="115" y="216">לתחושת משיכה או רתיעה.</text>
    </g>

    <rect x="20" y="245" width="190" height="42" rx="10" fill="#F2DCE6" stroke="#9E3B66"/>
    <text x="115" y="271" text-anchor="middle" fill="#7A244B" font-family="sans-serif" font-size="12.5" font-weight="700">סינון מהיר של חלופות גרועות</text>
  </g>

  <!-- ==================== שלב 4 (שמאל קיצוני): החלטה והצדקה ==================== -->
  <g transform="translate(30, 115)" filter="url(#stepShadow)">
    <rect width="230" height="305" rx="18" fill="#FCF9F5" stroke="#2E6B56" stroke-width="2.2"/>
    <circle cx="115" cy="48" r="26" fill="#DCECE6" stroke="#2E6B56" stroke-width="2"/>
    <text x="115" y="55" text-anchor="middle" fill="#235745" font-family="sans-serif" font-size="20" font-weight="800">4</text>

    <text x="115" y="102" text-anchor="middle" fill="#502638" font-family="sans-serif" font-size="18" font-weight="800">בחירה ונימוק מודע</text>
    <text x="115" y="124" text-anchor="middle" fill="#235745" font-family="sans-serif" font-size="13" font-weight="700">Guided Choice &amp; Reasoning</text>

    <line x1="25" y1="140" x2="205" y2="140" stroke="#DCECE6" stroke-width="1.5"/>

    <g fill="#252329" font-family="sans-serif" font-size="13.5" text-anchor="middle">
      <text x="115" y="172">הסמן הסומטי מכוון וממקד</text>
      <text x="115" y="194">את השיקול האנליטי לעבר</text>
      <text x="115" y="216">הבחירה הסופית של הצרכן.</text>
    </g>

    <rect x="20" y="245" width="190" height="42" rx="10" fill="#DCECE6" stroke="#2E6B56"/>
    <text x="115" y="271" text-anchor="middle" fill="#235745" font-family="sans-serif" font-size="12.5" font-weight="700">שילוב רגש והערכה רציונלית</text>
  </g>

  <!-- תיבת מסקנה תחתונה -->
  <rect x="95" y="455" width="910" height="72" rx="16" fill="#EBD9DF" stroke="#502638" stroke-width="1.8"/>
  <text x="550" y="484" text-anchor="middle" fill="#502638" font-family="sans-serif" font-size="15.5" font-weight="800">
    מסקנת דמאסיו (Damasio, 1994): רגש אינו אויב של הרציונליות — אלא תנאי הכרחי לקבלת החלטות יעילה
  </text>
  <text x="550" y="510" text-anchor="middle" fill="#252329" font-family="sans-serif" font-size="13.5" font-weight="600">
    ללא סמנים סומטיים שמצמצמים את מרחב האפשרויות, הצרכן נתקע בשיתוק אנליטי אינסופי מול שפע חלופות דומות
  </text>
</svg>
